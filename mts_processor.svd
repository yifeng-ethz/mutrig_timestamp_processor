<?xml version="1.0" encoding="UTF-8"?>
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Mu3e</vendor>
  <vendorID>MU3E</vendorID>
  <name>MU3E_MTS_PROCESSOR</name>
  <series>MU3E_FPGA_IP</series>
  <version>26.0.9.0501</version>
  <description>CMSIS-SVD description of the MuTRiG timestamp processor CSR window.</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>MTS_PROCESSOR_CSR</name>
      <description>Relative 8-word CSR aperture for the MuTRiG timestamp processor.</description>
      <groupName>MU3E_DATA_PATH</groupName>
      <baseAddress>0x0</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x20</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CONTROL_STATUS</name>
          <description>Mixed control/status word. Read bit 0 mirrors RUNNING; writes update control fields.</description>
          <addressOffset>0x0</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>go_or_running</name>
              <description>Write go; read RUNNING-state mirror.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>force_stop</name>
              <description>Manual stop gate.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>soft_reset</name>
              <description>One-shot local counter/state reset.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>bypass_lapse</name>
              <description>Bypass MTS-to-GTS lapse correction.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>discard_hiterr</name>
              <description>Discard hit_type0 beats with hiterr asserted.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>drop_delay_error</name>
              <description>Drop hit_type1 beats whose timestamp-delay sideband is asserted.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>delay_ts_field_use_t</name>
              <description>Use T timestamp for delay calculation.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>derive_tot</name>
              <description>Enable long-hit E-T derivation.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DISCARD_HIT_CNT</name>
          <description>Count of discarded input hits.</description>
          <addressOffset>0x4</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>value</name>
              <description>Discarded-hit count.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>EXPECTED_LATENCY</name>
          <description>Timestamp-latency error threshold in 8 ns ticks.</description>
          <addressOffset>0x8</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>expected_latency</name>
              <description>Expected hit latency; independent from overflow lookback.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TOTAL_HIT_CNT_HI</name>
          <description>Upper 16 bits of the accepted-hit counter.</description>
          <addressOffset>0xC</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>value</name>
              <description>Accepted-hit count high halfword.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TOTAL_HIT_CNT_LO</name>
          <description>Lower 32 bits of the accepted-hit counter.</description>
          <addressOffset>0x10</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>value</name>
              <description>Accepted-hit count low word.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OVERFLOW_LOOKBACK</name>
          <description>Post-wrap epoch-disambiguation lookback in 8 ns ticks.</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>overflow_lookback</name>
              <description>Runtime lapse/overflow lookback; writes are clamped to the non-negative MuTRiG wrap range.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RESERVED_6</name>
          <description>Reserved MTS processor CSR word 6.</description>
          <addressOffset>0x18</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>value</name>
              <description>Reserved.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RESERVED_7</name>
          <description>Reserved MTS processor CSR word 7.</description>
          <addressOffset>0x1C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>value</name>
              <description>Reserved.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
